# Frontend: leave empty in Vercel when API is served from the same domain.
VITE_API_URL=

# PostgreSQL. For Vercel/Neon, use DATABASE_URL or POSTGRES_URL.
DATABASE_URL=

# JWT secret. Set a strong random value in Vercel.
JWT_SECRET=

# Optional local PostgreSQL fallback:
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mangystau_go
DB_PASSWORD=
DB_PORT=5432
PORT=5000
